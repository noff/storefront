<div class="col">
  <%= link_to category, class: "category-tile" do %>
    <span class="category-tile__icon">
      <i class="bi bi-grid" aria-hidden="true"></i>
    </span>
    <span><%= category.name %></span>
    <i class="bi bi-arrow-right category-tile__arrow" aria-hidden="true"></i>
  <% end %>
</div>
