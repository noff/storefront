<% content_for :title, "Мой интернет-магазин" %>

<h1 class="visually-hidden">Storefront — интернет-магазин техники и аксессуаров</h1>

<%# ── Карусель баннеров + товар дня ───────────────────────────────────── %>
<section class="row g-4 mb-5">
  <div class="col-lg-8">
    <div id="mainCarousel" class="carousel slide h-100 rounded-4 overflow-hidden shadow-sm"
         data-controller="carousel" aria-label="Акции и предложения">
      <div class="carousel-indicators">
        <% @banners.each_with_index do |_banner, i| %>
          <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="<%= i %>"
                  class="<%= "active" if i.zero? %>" aria-label="Слайд <%= i + 1 %>"></button>
        <% end %>
      </div>

      <div class="carousel-inner h-100">
        <% @banners.each_with_index do |banner, i| %>
          <div class="carousel-item h-100 <%= "active" if i.zero? %>">
            <div class="hero-slide hero-slide--<%= banner[:variant] %> position-relative d-flex flex-column justify-content-center h-100 p-4 p-lg-5">
              <%# z-1 — чтобы текст остался над световым пятном .hero-slide::after %>
              <div class="position-relative z-1">
                <h2 class="display-5 fw-bold mb-2"><%= banner[:title] %></h2>
                <p class="lead opacity-75 mb-4"><%= banner[:text] %></p>
                <a href="#" class="btn btn-light btn-lg">
                  <%= banner[:cta] %><i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Назад</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Вперёд</span>
      </button>
    </div>
  </div>

  <% if @deal %>
    <div class="col-lg-4 d-flex flex-column">
      <h2 class="h6 fw-semibold text-body-secondary text-uppercase mb-2">
        <i class="bi bi-lightning-charge-fill text-warning me-1" aria-hidden="true"></i>Товар дня
      </h2>
      <div class="flex-grow-1">
        <%= render "product_card", product: @deal, wide: true %>
      </div>
    </div>
  <% end %>
</section>

<%# ── Блок сторис ─────────────────────────────────────────────────────── %>
<section class="mb-5" aria-label="Подборки">
  <div class="scroll-x pb-2">
    <ul class="stories-list w-max list-unstyled d-flex gap-3 mb-0">
      <% @stories.each do |story| %>
        <li class="story-item flex-shrink-0">
          <a href="#" class="d-block text-center text-decoration-none">
            <span class="story-ring d-inline-block p-1 rounded-circle">
              <%= image_tag placeholder_image(story, width: 160, height: 160, background: "#ffffff"),
                    class: "rounded-circle bg-body d-block", width: 76, height: 76, alt: "" %>
            </span>
            <span class="d-block small text-body-secondary mt-2 text-truncate"><%= story %></span>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# ── Сетка товаров ───────────────────────────────────────────────────── %>
<section class="mb-5">
  <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <h2 class="section-title h3">Популярные товары</h2>
    <a href="#" class="section-link link-secondary">
      Весь каталог <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 g-lg-4">
    <% @products.each do |product| %>
      <div class="col">
        <%= render "product_card", product: product %>
      </div>
    <% end %>
  </div>
</section>

<%# ── Категории ───────────────────────────────────────────────────────── %>
<% if @categories.exists? %>
  <section class="mb-5">
    <h2 class="section-title h3 mb-3">Категории</h2>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
      <% @categories.each do |category| %>
        <%= render "categories/category_card", category: category %>
      <% end %>
    </div>
  </section>
<% end %>

<%# ── Преимущества ────────────────────────────────────────────────────── %>
<section class="row row-cols-2 row-cols-lg-4 g-3 mb-5">
  <% [
       [ "bi-truck", "Быстрая доставка", "По России от 1 дня" ],
       [ "bi-shield-check", "Гарантия 2 года", "На всю технику" ],
       [ "bi-arrow-counterclockwise", "Возврат 14 дней", "Без лишних вопросов" ],
       [ "bi-headset", "Поддержка 24/7", "Ответим в любое время" ]
     ].each do |icon, title, text| %>
    <div class="col">
      <div class="panel h-100 p-3 p-lg-4">
        <i class="bi <%= icon %> fs-3 text-primary" aria-hidden="true"></i>
        <div class="fw-semibold mt-2"><%= title %></div>
        <div class="small text-body-secondary"><%= text %></div>
      </div>
    </div>
  <% end %>
</section>

<%# ── Нижний баннер ───────────────────────────────────────────────────── %>
<section class="promo-banner rounded-4 p-4 p-lg-5 text-center shadow-sm">
  <h2 class="display-6 fw-bold mb-2">Подпишитесь на рассылку</h2>
  <p class="lead opacity-75 mb-4">Персональные скидки и ранний доступ к распродажам</p>
  <a href="#" class="btn btn-light btn-lg">Получить промокод</a>
</section>
