<h1 class="visually-hidden">Storefront — интернет-магазин техники и аксессуаров</h1>

<%# ── Карусель баннеров + товар дня ───────────────────────────────────── %>
<section class="row g-4">
  <div class="col-lg-8">
    <div id="mainCarousel" class="carousel slide h-100 rounded-4 overflow-hidden shadow-sm"
         data-controller="carousel" aria-label="Акции и предложения">
      <div class="carousel-indicators">
        <% @banners.each_with_index do |_banner, i| %>
          <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="<%= i %>"
                  class="<%= "active" if i.zero? %>" aria-label="Слайд <%= i + 1 %>"></button>
        <% end %>
      </div>

      <div class="carousel-inner h-100">
        <% @banners.each_with_index do |banner, i| %>
          <div class="carousel-item h-100 <%= "active" if i.zero? %>">
            <div class="hero-slide hero-slide--<%= banner[:variant] %> d-flex flex-column justify-content-center h-100 p-5 text-white">
              <h2 class="display-6 fw-bold mb-2"><%= banner[:title] %></h2>
              <p class="lead mb-4 opacity-75"><%= banner[:text] %></p>
              <div>
                <a href="#" class="btn btn-light btn-lg px-4"><%= banner[:cta] %></a>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Назад</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Вперёд</span>
      </button>
    </div>
  </div>

  <div class="col-lg-4 d-flex flex-column">
    <h2 class="h6 fw-semibold mb-2">
      <i class="bi bi-lightning-charge-fill text-warning me-1" aria-hidden="true"></i>Товар дня
    </h2>
    <div class="flex-grow-1 shadow-sm rounded-4">
      <%= render "product_card", product: @deal, wide: true %>
    </div>
  </div>
</section>

<%# ── Блок сторис ─────────────────────────────────────────────────────── %>
<section class="my-5" aria-label="Подборки">
  <div class="stories-strip overflow-auto pb-2">
    <ul class="stories-list list-unstyled d-flex gap-3 mb-0">
      <% @stories.each do |story| %>
        <li class="story-item flex-shrink-0">
          <a href="#" class="d-block text-center text-decoration-none">
            <span class="story-ring d-inline-block p-1 rounded-circle">
              <%= image_tag placeholder_image(story, width: 160, height: 160, background: "#f8f9fa"),
                    class: "rounded-circle bg-body", width: 80, height: 80, alt: "" %>
            </span>
            <span class="d-block small text-body-secondary mt-2 text-truncate"><%= story %></span>
          </a>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<%# ── Сетка товаров ───────────────────────────────────────────────────── %>
<section>
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h4 mb-0">Популярные товары</h2>
    <a href="#" class="link-secondary text-decoration-none small">
      Весь каталог <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </a>
  </div>

  <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-4">
    <% @products.each do |product| %>
      <div class="col">
        <div class="h-100 shadow-sm rounded-4">
          <%= render "product_card", product: product %>
        </div>
      </div>
    <% end %>
  </div>
</section>

<%# ── Нижний баннер ───────────────────────────────────────────────────── %>
<section class="my-5 d-flex justify-content-center">
  <div class="promo-banner w-100 rounded-4 text-white p-5 text-center shadow-sm">
    <h2 class="display-6 fw-bold mb-2">Подпишитесь на рассылку</h2>
    <p class="lead opacity-75 mb-4">Персональные скидки и ранний доступ к распродажам</p>
    <a href="#" class="btn btn-light btn-lg px-4">Получить промокод</a>
  </div>
</section>
