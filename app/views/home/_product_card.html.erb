<%# Карточка товара. wide: true — широкая картинка (5:3), для блока «Товар дня». %>
<% wide = local_assigns.fetch(:wide, false) %>

<article class="product-card h-100 d-flex flex-column">
  <div class="product-card__media position-relative">
    <%= link_to product, class: "d-block" do %>
      <%= image_tag product.picture.presence || placeholder_image(product.name, width: 600, height: 600),
            class: "product-card__img #{'product-card__img--wide' if wide}", alt: product.name %>
    <% end %>

    <button class="product-card__fav btn btn-sm btn-icon rounded-circle position-absolute top-0 end-0 m-2"
            type="button" aria-label="Добавить «<%= product.name %>» в избранное">
      <i class="bi bi-heart" aria-hidden="true"></i>
    </button>

    <% if product.discount %>
      <span class="badge text-bg-danger position-absolute bottom-0 start-0 m-2">−<%= product.discount %>%</span>
    <% end %>
  </div>

  <div class="p-3 d-flex flex-column flex-grow-1">
    <div class="small mb-2"><%= rating_stars(product.rating) %></div>

    <h3 class="product-card__title h6 mb-2">
      <%= link_to product.name, product, class: "text-body" %>
    </h3>

    <div class="d-flex align-items-baseline gap-2 mb-3">
      <span class="<%= wide ? "fs-3 fw-bold" : "fs-5 fw-bold" %>"><%= price(product.price) %></span>
      <% if product.old_price %>
        <span class="text-body-tertiary text-decoration-line-through small">
          <%= price(product.old_price) %>
        </span>
      <% end %>
    </div>

    <%# mt-auto на форме, а не на кнопке: прижимаем к низу флекс-колонки. %>
    <%= button_to add_cart_path(product_id: product), method: :patch,
          class: "btn #{wide ? "btn-primary btn-lg" : "btn-light"}",
          form_class: "mt-auto d-grid" do %>
      <i class="bi bi-bag-plus me-1" aria-hidden="true"></i>В корзину
    <% end %>
  </div>
</article>
