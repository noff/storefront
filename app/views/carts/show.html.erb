<h1 class="h3 mb-4">Корзина</h1>

<% if @cart.empty? %>
  <div class="text-center text-body-secondary py-5">
    <i class="bi bi-bag fs-1 d-block mb-3" aria-hidden="true"></i>
    <p class="mb-3">Корзина пуста</p>
    <%= link_to "Перейти к товарам", root_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th scope="col">Товар</th>
        <th scope="col" class="text-end">Цена</th>
        <th scope="col" class="text-end">Кол-во</th>
        <th scope="col" class="text-end">Сумма</th>
        <th scope="col"><span class="visually-hidden">Удалить</span></th>
      </tr>
    </thead>
    <tbody>
      <% @cart.each do |item| %>
        <tr>
          <td><%= link_to item.product.name, item.product %></td>
          <td class="text-end"><%= price(item.product.price) %></td>
          <td class="text-end">
            <%= item.quantity %>
            <div class="btn-group ms-2">
              <%= link_to "-", decrease_cart_path(product_id: item.product.id), class: "btn btn-outline-secondary btn-sm", data: { turbo_method: :patch }  %>
              <%= link_to "+", increase_cart_path(product_id: item.product.id), class: "btn btn-outline-secondary btn-sm", data: { turbo_method: :patch }  %>
            </div>
          </td>
          <td class="text-end fw-semibold"><%= price(item.product.price.to_i * item.quantity) %></td>
          <td class="text-end">
            <%= button_to remove_cart_path(product_id: item.product.id), method: :delete,
                  class: "btn btn-link text-danger p-0", aria: { label: "Удалить «#{item.product.name}» из корзины" } do %>
              <i class="bi bi-trash-fill" aria-hidden="true"></i>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="3" class="text-end">Итого</th>
        <td class="text-end fs-5 fw-bold">
          <%= price(@cart.sum { |item| item.product.price.to_i * item.quantity }) %>
        </td>
        <td></td>
      </tr>
    </tfoot>
  </table>
<% end %>
