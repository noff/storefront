<% content_for :title, "Мои заказы" %>

<h1>Мои заказы</h1>

<table class="table">
  <thead>
  <tr>
    <th>Заказ</th>
    <th>Дата</th>
    <th class="text-end">Сумма</th>
  </tr>
  </thead>
  <tbody>
  <% @orders.each do |order| %>
  <tr>
    <td><%= link_to "Заказ #{order.id}", order %></td>
    <td><%= l order.created_at %></td>
    <td class="text-end"><%= order.total %></td>
  </tr>
  <% end %>
  </tbody>
</table>