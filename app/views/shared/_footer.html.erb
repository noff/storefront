<footer class="app-footer mt-auto pt-5 pb-4">
  <div class="app-container">
    <div class="row g-4 pb-4">
      <div class="col-lg-4">
        <div class="d-flex align-items-center gap-2 fs-4 fw-bold text-white mb-2">
          <i class="bi bi-bag-heart-fill text-primary" aria-hidden="true"></i>
          Storefront
        </div>
        <p class="small mb-3">Техника и аксессуары с доставкой по России. Честные цены, быстрая отправка.</p>
        <div class="d-flex gap-3 fs-5">
          <a href="#" aria-label="Telegram"><i class="bi bi-telegram" aria-hidden="true"></i></a>
          <a href="#" aria-label="ВКонтакте"><i class="bi bi-chat-dots" aria-hidden="true"></i></a>
          <a href="#" aria-label="YouTube"><i class="bi bi-youtube" aria-hidden="true"></i></a>
        </div>
      </div>

      <div class="col-6 col-lg-3">
        <h2 class="h6 text-white mb-3">Каталог</h2>
        <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
          <% nav_categories(limit: 5).each do |category| %>
            <li><%= link_to category.name, category %></li>
          <% end %>
          <li><%= link_to "Все категории", root_path %></li>
        </ul>
      </div>

      <div class="col-6 col-lg-2">
        <h2 class="h6 text-white mb-3">Покупателю</h2>
        <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
          <li><a href="#">Доставка</a></li>
          <li><a href="#">Оплата</a></li>
          <li><a href="#">Возврат</a></li>
          <li><%= link_to "Мои заказы", orders_path %></li>
        </ul>
      </div>

      <div class="col-lg-3">
        <h2 class="h6 text-white mb-3">Контакты</h2>
        <ul class="list-unstyled d-flex flex-column gap-2 small mb-0">
          <li><i class="bi bi-telephone me-2" aria-hidden="true"></i>8 800 000-00-00</li>
          <li><i class="bi bi-envelope me-2" aria-hidden="true"></i>help@storefront.ru</li>
          <li><i class="bi bi-clock me-2" aria-hidden="true"></i>Ежедневно 9:00–21:00</li>
        </ul>
      </div>
    </div>

    <div class="border-top border-secondary border-opacity-25 pt-3 small">
      © <%= Time.current.year %> Storefront
    </div>
  </div>
</footer>
