<%# Devise общается с пользователем только через flash — без этого блока он молчит. %>
<% flash_styles = {
     "notice" => [ "alert-success", "bi-check-circle-fill" ],
     "alert"  => [ "alert-danger",  "bi-exclamation-octagon-fill" ],
     "error"  => [ "alert-danger",  "bi-exclamation-octagon-fill" ]
   } %>

<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <% style, icon = flash_styles.fetch(type.to_s, [ "alert-info", "bi-info-circle-fill" ]) %>
  <div class="alert <%= style %> alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm" role="alert">
    <i class="bi <%= icon %>" aria-hidden="true"></i>
    <span><%= message %></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
  </div>
<% end %>
