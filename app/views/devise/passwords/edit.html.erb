<% content_for :title, "Новый пароль" %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5 col-xl-4">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h4 d-flex align-items-center gap-2 mb-4">
          <i class="bi bi-key text-primary" aria-hidden="true"></i>
          Смена пароля
        </h1>

        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= f.error_notification %>

          <%= f.input :reset_password_token, as: :hidden %>
          <%= f.full_error :reset_password_token %>

          <%= f.input :password,
                      label: "Новый пароль",
                      required: true,
                      autofocus: true,
                      hint: ("Минимум #{@minimum_password_length} символов" if @minimum_password_length),
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Подтверждение нового пароля",
                      required: true,
                      input_html: { autocomplete: "new-password" } %>

          <%= f.button :submit, "Сменить пароль", class: "btn btn-primary btn-lg w-100" %>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
