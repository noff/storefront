<% content_for :title, "Новый пароль" %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5 col-xl-4">
    <div class="auth-card p-4 p-lg-5">
      <div class="auth-icon mb-3"><i class="bi bi-key" aria-hidden="true"></i></div>
      <h1 class="h3 mb-1">Смена пароля</h1>
      <p class="text-body-secondary mb-4">Придумайте новый пароль для входа</p>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>

        <%= f.input :password,
                    label: "Новый пароль",
                    required: true,
                    autofocus: true,
                    hint: ("Минимум #{@minimum_password_length} символов" if @minimum_password_length),
                    input_html: { autocomplete: "new-password" } %>
        <%= f.input :password_confirmation,
                    label: "Подтверждение нового пароля",
                    required: true,
                    input_html: { autocomplete: "new-password" } %>

        <%= f.button :submit, "Сменить пароль", class: "btn btn-primary btn-lg w-100 mt-2" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
