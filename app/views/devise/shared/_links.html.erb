<%# Только модули, включённые в User: registerable + recoverable. %>
<div class="d-flex flex-column gap-2 mt-4 pt-3 border-top small text-center">
  <% if controller_name != "sessions" %>
    <%= link_to "Уже есть аккаунт? Войти", new_session_path(resource_name), class: "link-secondary" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Нет аккаунта? Зарегистрироваться", new_registration_path(resource_name), class: "link-secondary" %>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to "Забыли пароль?", new_password_path(resource_name), class: "link-secondary" %>
  <% end %>
</div>
