<script>
    r46("track", "sign_in_page");
</script>

<% content_for :title, "Вход" %>

<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5 col-xl-4">
    <div class="auth-card p-4 p-lg-5">
      <div class="auth-icon mb-3"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i></div>
      <h1 class="h3 mb-1">С возвращением</h1>
      <p class="text-body-secondary mb-4">Войдите, чтобы видеть свои заказы</p>

      <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <%= f.input :email,
                    required: false,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
        <%= f.input :password,
                    required: false,
                    input_html: { autocomplete: "current-password" } %>
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

        <%= f.button :submit, "Войти", class: "btn btn-primary btn-lg w-100 mt-2" %>
      <% end %>

      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
