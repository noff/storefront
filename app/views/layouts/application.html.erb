<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Storefront" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Storefront">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-body-tertiary">
    <header class="navbar navbar-expand bg-body border-bottom sticky-top py-3">
      <div class="container-fluid px-4 gap-3">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2 m-0 fw-semibold" do %>
          <i class="bi bi-shop fs-3 text-primary" aria-hidden="true"></i>
          <span class="d-none d-sm-inline">Storefront</span>
        <% end %>

        <%# TODO: обработчик q в home#index пока не реализован — форма возвращает на главную. %>
        <%= form_with url: root_path, method: :get, class: "flex-grow-1" do |f| %>
          <div class="input-group">
            <%= f.search_field :q, value: search_query, class: "form-control form-control-lg",
                  placeholder: "Поиск по товарам", "aria-label": "Поиск по товарам" %>
            <button class="btn btn-primary px-4" type="submit" aria-label="Найти">
              <i class="bi bi-search" aria-hidden="true"></i>
            </button>
          </div>
        <% end %>

        <%= link_to cart_path, class: "btn btn-outline-secondary btn-lg position-relative" do %>
          <i class="bi bi-bag" aria-hidden="true"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            <%= current_cart.count %>
            <span class="visually-hidden">товаров в корзине</span>
          </span>
        <% end %>

        <% if user_signed_in? %>
          <div class="dropdown">
            <button class="btn btn-outline-secondary btn-lg dropdown-toggle" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
              <i class="bi bi-person-circle" aria-hidden="true"></i>
              <span class="d-none d-lg-inline ms-1"><%= current_user.email %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><%= link_to "Профиль", edit_user_registration_path, class: "dropdown-item" %></li>
              <li><%= link_to "Мои заказы", orders_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Выйти", destroy_user_session_path, method: :delete,
                      class: "dropdown-item" %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to new_user_session_path, class: "btn btn-outline-secondary btn-lg text-nowrap" do %>
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
            <span class="d-none d-md-inline ms-1">Войти</span>
          <% end %>
          <%= link_to "Регистрация", new_user_registration_path,
                class: "btn btn-primary btn-lg text-nowrap d-none d-md-inline-block" %>
        <% end %>
      </div>
    </header>

    <main class="container-fluid px-4 py-4">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
