<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "Storefront" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Storefront">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <script>
        (function(r){
            window.r46=window.r46||function(){(window.r46.q=window.r46.q||[]).push(arguments)};
            var c="https://cdn.rees46.ru",v="/v3.js",s={link:[{href:c,rel:"dns-prefetch"},{href:c,rel:"preconnect"},{href:c+v,rel:"preload",as:"script"}],script:[{src:c+v,async:""}]};
            Object.keys(s).forEach(function(c){s[c].forEach(function(d){var e=document.createElement(c),a;for(a in d)e.setAttribute(a,d[a]);document.head.appendChild(e)})});
        })();
        r46('init', '<%= ENV.fetch("REES46_PUBLIC_KEY") %>', null, null, null, {}, true);
        document.addEventListener("turbo:load", function(){
            r46('profile', 'set', {
                "location": "<%= current_city.code %>"
            });
            <% if user_signed_in? %>
              r46('profile', 'set', {
                  "email": "<%= current_user.email %>",
                  "id": "<%= current_user.id %>",
              });
            <% end %>
        })
    </script>

    <script>
      <% if session[:added_to_cart].present? %>
        r46("track", "cart", "<%= session[:added_to_cart] %>");
        <% session.delete(:added_to_cart) %>
      <% end %>
      <% if session[:removed_from_cart].present? %>
        r46("track", "remove_from_cart", "<%= session[:removed_from_cart] %>");
        <% session.delete(:removed_from_cart) %>
      <% end %>
    </script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <header class="app-header sticky-top">
      <div class="app-container d-flex align-items-center gap-3 py-2 py-lg-3">
        <%= link_to root_path, class: "app-brand navbar-brand d-flex align-items-center gap-2 m-0 fw-bold fs-4 text-body" do %>
          <i class="bi bi-bag-heart-fill fs-3 text-primary" aria-hidden="true"></i>
          <span class="d-none d-sm-inline">Storefront</span>
        <% end %>

        <div class="dropdown flex-shrink-0">
          <button class="btn btn-light text-nowrap d-flex align-items-center gap-1" type="button"
                  data-bs-toggle="dropdown" aria-expanded="false" aria-label="Выбрать город">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <span class="d-none d-sm-inline"><%= current_city.name %></span>
            <i class="bi bi-chevron-down small" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu">
            <li class="dropdown-header">Выберите город</li>
            <% City::ALL.each do |city| %>
              <li>
                <%= button_to city_path(code: city.code), method: :patch,
                      class: "dropdown-item d-flex align-items-center justify-content-between gap-2" do %>
                  <%= city.name %>
                  <% if city.code == current_city.code %>
                    <i class="bi bi-check2 text-primary" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>

        <%# TODO: обработчик q в home#index пока не реализован — форма возвращает на главную. %>
        <%= form_with url: root_path, method: :get, class: "flex-grow-1" do |f| %>
          <div class="search-pill d-flex align-items-center ps-3">
            <i class="bi bi-search text-body-tertiary" aria-hidden="true"></i>
            <%= f.search_field :q, value: search_query, class: "form-control form-control-lg",
                  placeholder: "Поиск по товарам", "aria-label": "Поиск по товарам" %>
            <button class="btn btn-primary d-none d-sm-inline-flex" type="submit">Найти</button>
          </div>
        <% end %>

        <%= link_to cart_path, class: "btn btn-light btn-icon position-relative fs-5",
              aria: { label: "Корзина" } do %>
          <i class="bi bi-bag" aria-hidden="true"></i>
          <% if current_cart.count.positive? %>
            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">
              <%= current_cart.count %>
              <span class="visually-hidden">товаров в корзине</span>
            </span>
          <% end %>
        <% end %>

        <% if user_signed_in? %>
          <div class="dropdown">
            <button class="btn btn-light btn-icon fs-5" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Аккаунт">
              <i class="bi bi-person" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li class="dropdown-header dropdown-email text-truncate"><%= current_user.email %></li>
              <li><%= link_to "Профиль", edit_user_registration_path, class: "dropdown-item" %></li>
              <li><%= link_to "Мои заказы", orders_path, class: "dropdown-item" %></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <%= button_to "Выйти", destroy_user_session_path, method: :delete,
                      class: "dropdown-item text-danger" %>
              </li>
            </ul>
          </div>
        <% else %>
          <%= link_to new_user_session_path, class: "btn btn-light btn-icon fs-5 d-lg-none",
                aria: { label: "Войти" } do %>
            <i class="bi bi-person" aria-hidden="true"></i>
          <% end %>
          <%= link_to "Войти", new_user_session_path, class: "btn btn-light text-nowrap d-none d-lg-inline-block" %>
          <%= link_to "Регистрация", new_user_registration_path,
                class: "btn btn-primary text-nowrap d-none d-lg-inline-block" %>
        <% end %>
      </div>

      <% if nav_categories.any? %>
        <nav class="app-container pb-2 d-none d-md-block" aria-label="Категории">
          <div class="scroll-x">
            <ul class="list-unstyled d-flex gap-1 mb-0 w-max">
              <% nav_categories.each do |category| %>
                <li><%= link_to category.name, category, class: "nav-chip" %></li>
              <% end %>
            </ul>
          </div>
        </nav>
      <% end %>
    </header>

    <main class="app-container py-4 py-lg-5 flex-grow-1">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
